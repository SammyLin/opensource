{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSS Perks program (data/programs/<id>.json)",
  "$defs": {
    "i18n": {
      "type": "object",
      "required": [
        "zh-Hant",
        "zh-Hans",
        "en"
      ],
      "properties": {
        "zh-Hant": {
          "type": "string",
          "minLength": 1,
          "description": "繁體中文（台灣用詞）"
        },
        "zh-Hans": {
          "type": "string",
          "minLength": 1,
          "description": "简体中文（大陆用词）"
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "description": "English"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "id",
    "name",
    "whatYouGet",
    "whyItHelps",
    "requirements",
    "type",
    "category",
    "link",
    "lastVerified"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "網址代號，例如 sentry → /p/sentry/；建立後不要改，否則分享出去的連結會失效；必須和檔名相同（data/programs/<id>.json）"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "方案正式英文名稱"
    },
    "logo": {
      "type": "string",
      "pattern": "^/logos/[a-z0-9-]+\\.svg$",
      "description": "選填：public/logos/ 底下的 SVG，例如 /logos/sentry.svg；沒有就顯示名稱縮寫"
    },
    "whatYouGet": {
      "$ref": "#/$defs/i18n",
      "description": "提供什麼"
    },
    "whyItHelps": {
      "$ref": "#/$defs/i18n",
      "description": "對開源專案有什麼幫助（一兩句話說清楚這個工具在幹嘛）"
    },
    "requirements": {
      "$ref": "#/$defs/i18n",
      "description": "申請條件"
    },
    "type": {
      "enum": [
        "direct_activation",
        "application_required",
        "high_bar"
      ],
      "description": "direct_activation 直接開通 / application_required 要申請 / high_bar 門檻高"
    },
    "category": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "categories 裡的 id；依 CNCF 慣例通常一個方案放一格"
    },
    "link": {
      "type": "string",
      "pattern": "^https?://",
      "description": "官方來源連結"
    },
    "lastVerified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD"
    },
    "pending": {
      "description": "選填：條件暫時無法從官方確認時才用，網站顯示「待確認」",
      "type": "object",
      "required": [
        "zh-Hant",
        "zh-Hans",
        "en"
      ],
      "properties": {
        "zh-Hant": {
          "type": "string",
          "minLength": 1
        },
        "zh-Hans": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "link": {
          "type": "string",
          "pattern": "^https?://"
        }
      },
      "additionalProperties": false
    }
  }
}
